# Copy to .env.local and fill in. See BDE_Agent_Spec.md Section 8/21.

# --- Database (Section 13) ---
DATABASE_URL=

# --- Auth (NextAuth) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Admin login, used only by scripts/seed.ts ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- LLM (Section 7/21) — OpenRouter free tier (openrouter.ai/keys), no card required.
# Default model is a genuinely free one — check openrouter.ai/models?max_price=0
# for the current list (availability changes over time).
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b:free
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Lead sourcing/enrichment (Section 3/8) ---
APOLLO_API_KEY=
HUNTER_API_KEY=
BUILTWITH_API_KEY=
CRUNCHBASE_API_KEY=

# --- Sending: option A — SMTP (Section 8 free-tier path, e.g. Gmail/Workspace) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your dedicated outreach
# Gmail address, SMTP_PASS=16-character App Password (NOT your normal password —
# requires 2-Step Verification: https://myaccount.google.com/apppasswords).
# Use a DEDICATED outreach inbox, never your main domain/personal email (Section 5/8).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Sending: option B — Instantly.ai/Smartlead (Section 7/8) — used if SMTP_USER
# is not set. Better deliverability tooling/warm-up tracking once you have budget.
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=
OUTREACH_FROM_EMAIL=

# --- Booking (Section 7/8) ---
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=

# --- Deposits (Section 17, optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Notifications (Section 14) — set one or both ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Cron protection (Section 21) — Vercel sends this automatically as a
# Bearer token when CRON_SECRET is set as a Vercel env var ---
CRON_SECRET=
