# Postgres connection string (Neon/Supabase free tier or local) — must have the pgvector extension enabled
DATABASE_URL=postgresql://user:password@host:5432/docmind?sslmode=require

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Groq model used for generation + LLM-as-judge scoring
GROQ_MODEL=llama-3.3-70b-versatile

PORT=4000

# Directory (relative to backend/) where uploaded files are stored on disk
UPLOAD_DIR=uploads
