# Database: zero-setup SQLite file via Node's built-in node:sqlite (no service, no credentials).
# The schema is applied automatically on startup. To move to Postgres for production,
# swap the implementation in src/db/pool.ts (same query() shape is used everywhere).
SQLITE_FILE=ledgerlite.db

# Server
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000

# AI (Groq — free tier at https://console.groq.com/keys)
# If left blank, the AI service falls back to a deterministic mock
# so the app still works end-to-end without a key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# File storage (receipt images). Demo stores locally under /uploads.
UPLOAD_DIR=uploads
